# Test image for the Sigur integration.
#
# Home Assistant core cannot be imported on Windows (it imports `fcntl`), so the
# Home Assistant part of the suite runs in this container. The protocol-only
# tests (tests/test_parser.py) run on any platform without it.
FROM python:3.13-slim

# Home Assistant still pins lru-dict 1.3.0, which has no wheel for Python 3.13
# and needs a C toolchain. 1.4.1 is API compatible and ships wheels.
RUN printf 'lru-dict==1.4.1\n' > /tmp/overrides.txt

RUN pip install --no-cache-dir uv \
    && uv pip install --system --overrides /tmp/overrides.txt \
        pytest-homeassistant-custom-component \
        ruff \
        mypy

# The frontend package is not a dependency of the `homeassistant` wheel, but
# the integration registers a sidebar panel, so `frontend` and `panel_custom`
# have to be able to set up. Install exactly the version Home Assistant asks
# for, so the pair never drifts apart.
RUN python -c "import json, pathlib; import homeassistant.components.frontend as f;       print(json.loads((pathlib.Path(f.__file__).parent / 'manifest.json').read_text())['requirements'][0])"     > /tmp/frontend.txt     && uv pip install --system -r /tmp/frontend.txt

WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "pytest", "-q"]
